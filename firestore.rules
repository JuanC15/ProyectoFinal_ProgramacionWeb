rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: each user can create/read/update their own profile.
    // Admin users (role == 'admin') can read/update other users.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId ||
        // allow admins to read other users
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
      allow update: if request.auth != null && (request.auth.uid == userId ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
      allow delete: if false;
    }

    match /incidentes/{incidentId} {
      // any authenticated user can read incidents
      allow read: if request.auth != null;

      // creating an incident must set createdBy to the authenticated uid
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;

      // updates/deletes allowed for the owner or admins
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
